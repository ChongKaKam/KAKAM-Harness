# Run ./depoly.sh to create .env with an automatically generated APP_SECRET. Register the first admin in the web UI.
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3600
DATA_DIR=./data
# Development: use http://localhost:5173. Direct Docker: http://localhost:3600.
PUBLIC_ORIGIN=http://localhost:3600
# Set true behind HTTPS. Set TRUST_PROXY=1 only behind one trusted reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=0
# Host port binding. Change to 0.0.0.0 for direct LAN access if desired.
BIND_ADDRESS=127.0.0.1
