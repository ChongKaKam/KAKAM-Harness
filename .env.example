# Run ./deploy.sh to create .env with an automatically generated APP_SECRET. Register the first admin in the web UI.
# Back up the real .env together with the data volume. Keep APP_SECRET unchanged on redeploys and migrations.
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3600
DATA_DIR=./data
# Development: use http://localhost:5173. Direct Docker: http://localhost:3600.
PUBLIC_ORIGIN=http://localhost:3600
# Set true behind HTTPS. Set TRUST_PROXY=1 only behind one trusted reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=0
# Per-account active chat replies (1–20); each conversation still allows only one.
MAX_CONCURRENT_CHATS=5
# Host port binding. Change to 0.0.0.0 for direct LAN access if desired.
BIND_ADDRESS=127.0.0.1

# Optional Memory plugin: a separate PostgreSQL database with pgvector installed.
# Shared production: compose.yaml + compose.memory-shared.yaml. Administrator provisions the role/schema/extension.
# Never change MEMORY_NAMESPACE after saving memories without a coordinated migration.
# MEMORY_DATABASE_URL=postgresql://kakamlab_drift_memory:replace-with-url-encoded-password@kakamlab-db:5656/kakamlab_drift_memory_db
MEMORY_NAMESPACE=drift-space
# MEMORY_DB_SCHEMA=drift_memory
# The four metadata fields must all match the URL; they populate Monitor labels (no password).
# MEMORY_DB_HOST=kakamlab-db
# MEMORY_DB_PORT=5656
# MEMORY_DB_NAME=kakamlab_drift_memory_db
# MEMORY_DB_USER=kakamlab_drift_memory
# Persist the shared Compose combination on the production server; do not enable both overlays.
# COMPOSE_FILE=compose.yaml:compose.memory-shared.yaml
MEMORY_DB_POOL_MAX=5
MEMORY_DB_APPLICATION_NAME=drift-space-memory

# Disposable local development only: compose.yaml + compose.memory.yaml instead of the shared overlay.
# Leave the shared MEMORY_DB_* metadata and MEMORY_DB_SCHEMA unset for this option.
# MEMORY_DATABASE_URL=postgresql://memory:replace-with-url-encoded-password@memory-db:5432/drift_memory
# MEMORY_DB_PASSWORD=replace-with-database-password
